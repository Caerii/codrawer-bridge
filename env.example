# Desktop server config (copy to `.env`)

# AI throttling knobs (50 RPM constraint)
CODRAWER_AI_MIN_MODEL_INTERVAL_S=1.3
CODRAWER_AI_DEBOUNCE_S=0.25

# Optional: future model integration
# CODRAWER_GLM_API_KEY=...
# CODRAWER_GLM_BASE_URL=...

# Optional: call the local Node model-server (model-server/) for AI output
# Start it with: (in model-server/)
#   pnpm install
#   pnpm dev
CODRAWER_MODEL_SERVER_URL=http://127.0.0.1:3100
CODRAWER_MODEL_SERVER_MODEL=blazing_fast
CODRAWER_MODEL_SERVER_TIMEOUT_S=20
CODRAWER_MODEL_SERVER_TEMPERATURE=0.4

# Optional: include a rendered context image patch (requires Pillow; model must support vision)
CODRAWER_MODEL_SERVER_USE_CONTEXT_IMAGE=0
CODRAWER_MODEL_SERVER_CONTEXT_IMAGE_PX=256
CODRAWER_MODEL_SERVER_CONTEXT_IMAGE_WINDOW=0.22

# Optional: auto AI replies (AI responds without explicit prompt)
CODRAWER_AI_AUTO_ENABLED=0
CODRAWER_AI_AUTO_DELAY_S=0.9

# Optional: co-creative agent persona knobs (used by model-server)
CODRAWER_AGENT_PERSONA=Codrawer
CODRAWER_AGENT_PERSONALITY="Playful, curious, collaborative. Adds tasteful details and structure. Never hijacks."
CODRAWER_AGENT_CREATIVITY=0.7
CODRAWER_AGENT_CHATTINESS=0.25

# Optional: agent initiative (agent starts sometimes when you're idle)
CODRAWER_AGENTIC_ENABLED=0
CODRAWER_AGENTIC_IDLE_S=1.4
CODRAWER_AGENTIC_MIN_INTERVAL_S=10.0
CODRAWER_AGENTIC_PROBABILITY=0.35
CODRAWER_AGENTIC_PROMPT="Co-create: add a small complementary doodle or augmentation that weaves with the current sketch. Be subtle and leave space. Prefer 1-3 strokes."

# Optional: even-terminal bridge (server/term_bridge.py). Leave URL empty to disable.
# Start even-terminal with:  even-terminal start --token sig-glasses --provider claude --cwd <repo> -p 3456
CODRAWER_TERM_URL=http://127.0.0.1:3456
CODRAWER_TERM_TOKEN=sig-glasses
CODRAWER_TERM_PROVIDER=claude
# Working directory of the terminal session; drawings and the shared document are written
# under <CODRAWER_TERM_CWD>/.codrawer/ so the agent can Read them (docs/adr/002).
CODRAWER_TERM_CWD=C:/Github/tool-codrawer-bridge
# Pin a terminal session id instead of one-per-codrawer-session (rarely needed)
# CODRAWER_TERM_SESSION=

# Debug: print every incoming websocket message type (stdout is buffered when redirected)
CODRAWER_DEBUG_LOG_MSGS=0
