# model-server environment (copy to model-server/.env — never commit .env)

# Cerebras (fast path for sub-second ghost ink; the `blazing_fast` alias)
CEREBRAS_API_KEY=

# Amazon Bedrock (Claude via the `opus` / `powerful_and_smart` aliases)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Together AI (default provider for open-source aliases: kimi-k2, qwen3, llama-4)
TOGETHER_AI_API_KEY=

# Optional direct providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Server
PORT=3100
HOST=localhost
