# AI SDK Model Server Environment Variables
# Copy this file to .env and fill in your API keys

# Together AI (default provider for open-source models)
TOGETHER_AI_API_KEY=your_together_api_key_here

# OpenAI (optional - for GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (optional - for Claude models via direct API)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google AI (optional - for Gemini models)
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# Cerebras (BLAZING FAST inference - 1000 req/min, 1M tokens/min!)
# Perfect for quick, simple tasks that need extreme speed
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Amazon Bedrock (for Claude Opus 4.5 with free credits)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# Server Configuration
PORT=3100
HOST=localhost


