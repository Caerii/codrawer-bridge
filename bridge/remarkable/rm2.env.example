# reMarkable 2 live pen stream; verified on OS 3.28.0.172.
# Wacom portrait mapping: page x = raw y, page y = 1 - raw x (normalized).
CODRAWER_TABLET_MODEL=rm2
INPUT_DEVICE=/dev/input/event1
PEN_SWAP_XY=1
PEN_INVERT_X=0
PEN_INVERT_Y=1
NO_GRAB=1
KEYBOARD_DEVICE=off
TYPE_REPLIES=0
PAGE_WATCH=off
TOOL_FILE=off
INK_SOCKET=off
NATIVE_AGENT_INK=0
SERVE_ADDR=:8577
DESKTOP_WS=ws://127.0.0.1:8577/ws/session1
# Set a pairing code before listening on the LAN. Never commit your actual code.
ROUTER_TOKEN=CHANGE_ME
