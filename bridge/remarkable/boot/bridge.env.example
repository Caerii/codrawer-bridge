# /home/root/codrawer/bridge.env — read by codrawer-bridge.service (install.sh seeds it from this
# file once and never overwrites it). Edit on the tablet, then: systemctl restart codrawer-bridge
# The bridge hosts the stroke router itself (SERVE_ADDR) and streams into it over loopback; the
# glasses app connects to ws://<tablet-ip>:8577/ws/session1. To use the desktop router instead
# (AI, /term), drop SERVE_ADDR and set DESKTOP_WS=ws://<desktop-ip>:8577/ws/session1.
SERVE_ADDR=:8577
DESKTOP_WS=ws://127.0.0.1:8577/ws/session1
# The auto-probe picks event0 (the power key); the Elan marker is event2.
INPUT_DEVICE=/dev/input/event2
TOUCH_MODE=auto
NO_GRAB=1
KEYBOARD_DEVICE=auto
TYPE_REPLIES=1
# How replies are typed: TYPE_CHAR_MS (default 12) is the pause; TYPE_BATCH=word types a whole word
# per write and pauses once per word (~5x faster; not yet verified against xochitl, so off).
#TYPE_BATCH=word
# Page watcher: sends xochitl's saved page (exact tools, colours, erases, page turns) as `page`
# snapshots, reading its files only. auto = only on an OS version listed in compat.conf.
#PAGE_WATCH=auto
# Pairing code clients off the tablet must present (?token=…); the pen bridge on loopback is exempt.
# deploy-tablet.sh creates one; empty = open to anyone on the network.
#ROUTER_TOKEN=XXXX-XXXX
# Bridge engine: go (default) or rust (same flags and behaviour, less memory). Both ship in every
# release; change this and `systemctl restart codrawer-bridge` to switch.
ENGINE=go
# Keyboard link (read by the keyboard keeper, codrawer-bluetooth.service): 1 asks for a 7.5–15 ms
# BLE connection interval on every connect instead of the keyboard's 20–25 ms, cutting the radio's
# share of key latency from ~12 to ~4–8 ms on average, at some battery cost to the keyboard
# (keyboard-keeper.sh). Then: systemctl restart codrawer-bluetooth
#KEYBOARD_FAST_LINK=1
