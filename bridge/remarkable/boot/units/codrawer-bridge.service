# The pen + keyboard bridge and the stroke router. Installed into /run/systemd/system by boot.sh
# at every boot. Settings: /home/root/codrawer/bridge.env; /run/codrawer/env carries what boot.sh
# derives (OS version, whether it is a tested one) for the bridge's compatibility gating.
# Restarts quickly forever; past the start limit systemd gives up until boot.sh start (boot,
# activate, rollback) clears it with reset-failed. Logs: journalctl -u codrawer-bridge.
[Unit]
Description=codrawer: pen + keyboard bridge and stroke router
After=network-online.target codrawer-bluetooth.service
Wants=network-online.target
RequiresMountsFor=/home/root
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=/home/root/codrawer/bridge.env
EnvironmentFile=-/run/codrawer/env
# run-bridge.sh picks the engine (ENGINE=go|rust in bridge.env)
ExecStart=/bin/sh /home/root/codrawer/current/run-bridge.sh
Restart=always
RestartSec=2
