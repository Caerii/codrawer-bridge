{
  "name": "codrawer-even-g2",
  "version": "0.1.0",
  "private": true,
  "description": "Even Realities G2 view of a codrawer-bridge session (Even Hub web app)",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5188",
    "build": "tsc -p . && vite build",
    "preview": "vite preview --host --port 5188",
    "sim": "evenhub-simulator http://localhost:5188",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsx --test test/*.test.ts",
    "ehpk": "tsc -p . && vite build && node manifest.mjs && evenhub pack app.packed.json dist -o codrawer.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "fflate": "^0.8.3",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
