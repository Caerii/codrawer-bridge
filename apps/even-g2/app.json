{
  "package_id": "group.superintelligent.codrawer",
  "edition": "202609",
  "name": "Codrawer",
  "version": "0.1.0",
  "min_app_version": "2.2.10",
  "min_sdk_version": "0.0.16",
  "entrypoint": "index.html",
